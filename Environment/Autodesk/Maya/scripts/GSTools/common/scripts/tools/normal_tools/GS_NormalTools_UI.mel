// Self-contained: the transfer/copy procs below used to live in a separate
// (uncommitted) MEL and were the source of "GS_TransferAttrNormal not found".

global proc GS_TransferAttrNormal(string $srcObj, string $dstObj){
	string $srcPath[] = `listRelatives -f -p $srcObj` ;
	string $dstPath[] = `listRelatives -f -p $dstObj` ;
	// unparent Object first - avoid Freeze transfrom all nodes above of an Obj
	string $tmpStr[] ;
	if (size($srcPath)){
		$tmpStr = `parent -w $srcObj` ;
		$srcObj = $tmpStr[0] ;
	}
	if (size($dstPath)){
		$tmpStr = `parent -w $dstObj` ;
		$dstObj = $tmpStr[0] ;
	}

	makeIdentity -apply true -t 1 -r 1 -s 1 -n 0 $srcObj ;
	DeleteHistory $srcObj ;
	makeIdentity -apply true -t 1 -r 1 -s 1 -n 0 $dstObj ;
	DeleteHistory $dstObj ;

	transferAttributes -transferPositions 0 -transferNormals 1 -transferUVs 0 -transferColors 0 -sampleSpace 0 -searchMethod 3 -flipUVs 0 -colorBorders 1 $srcObj $dstObj;
	DeleteHistory $dstObj ;

	// Reparent Object to the original DAG path
	if (size($srcPath)){
		parent $srcObj $srcPath[0] ;
	}
	if (size($dstPath)){
		parent $dstObj $dstPath[0] ;
	}
}

//
// Copy vertex normals from a source vertex array to a destination vertex array
// by nearest world-space position (order-independent).
//
global proc geCopyVertexNormalArr(string $vtxSrc[], string $vtxDst[]){
	for ($aDst in $vtxDst){
		float $dPos[] = `xform -q -ws -t $aDst`;
		float $shortest = 1000000;
		string $closest = "";
		for ($aSrc in $vtxSrc){
			float $sPos[] = `xform -q -ws -t $aSrc`;
			float $d = (($sPos[0]-$dPos[0])*($sPos[0]-$dPos[0]))
					 + (($sPos[1]-$dPos[1])*($sPos[1]-$dPos[1]))
					 + (($sPos[2]-$dPos[2])*($sPos[2]-$dPos[2]));
			if ($d < $shortest){
				$shortest = $d;
				$closest = $aSrc;
			}
		}
		if ($closest != ""){
			float $n[] = `polyNormalPerVertex -q -xyz $closest`;
			polyNormalPerVertex -xyz $n[0] $n[1] $n[2] $aDst;
		}
	}
}

//
// TransferNormal2RecessPart: delete history, freeze transform before doing transfer Normal to Recess Part
//
global proc GS_TransferNormal2RecessPart(string $srcObj, string $dstObj){
	string $srcPath[] = `listRelatives -f -p $srcObj` ;
	string $dstPath[] = `listRelatives -f -p $dstObj` ;
	// unparent Object first - avoid Freeze transfrom all nodes above of an Obj
	string $tmpStr[] ;
	if (size($srcPath)){
		$tmpStr = `parent -w $srcObj` ;
		$srcObj = $tmpStr[0] ;
	}
	if (size($dstPath)){
		$tmpStr = `parent -w $dstObj` ;
		$dstObj = $tmpStr[0] ;
	}

	makeIdentity -apply true -t 1 -r 1 -s 1 -n 0 $srcObj ;
	DeleteHistory $srcObj ;
	makeIdentity -apply true -t 1 -r 1 -s 1 -n 0 $dstObj ;
	DeleteHistory $dstObj ;
	// Duplicate Target Mesh and then transfer Normal from Source to Dup Mesh
	string $dupTarget[] = `duplicate $dstObj` ;
	transferAttributes -transferPositions 0 -transferNormals 1 -transferUVs 0 -transferColors 0 -sampleSpace 0 -searchMethod 3 -flipUVs 0 -colorBorders 1 $srcObj $dupTarget[0];
	DeleteHistory $dupTarget[0] ;
	// Copy Normal of Vertices at border back to Target ($dst) mesh
	//
	select $dupTarget ;
	ConvertSelectionToVertices ;
	string $vtxSrc[] = `ls -sl -fl -l`;
	select $dstObj ;
	ConvertSelectionToVertices ;
	polyConvertToShellBorder ;
	string $vtxDst[] = `ls -sl -fl -l`;
	geCopyVertexNormalArr($vtxSrc, $vtxDst) ;
	DeleteHistory $dstObj ;
	delete $dupTarget[0] ;
	select -cl ;
	// Reparent Object to the original DAG path
	if (size($srcPath)){
		parent $srcObj $srcPath[0] ;
	}
	if (size($dstPath)){
		parent $dstObj $dstPath[0] ;
	}
}

//
// cqDung: this function is cited from CG_NormalTools due to showed UI when Source the script
//
global proc GS_CopyNormals()
{
	// Construction History Off
	constructionHistory -toggle on;

	string $sel[] = `ls -sl -l -fl`; select -cl;
	string $closestVert, $vertSel[], $sourceSel[];

	// if selection is >2 i.e. verts
	if (size($sel) > 2)
	{
		for ($i=0;$i<(size($sel) - 1);$i++)
		{
			$vertSel[$i] = $sel[$i];
		}

		select $sel[size($sel)-1];
		ConvertSelectionToVertices;
		$sourceSel = `ls -sl -fl -l`;
	}

	// if selection is == 2 ie objects
	if (size($sel) == 2)
	{
		select $sel[0];
		ConvertSelectionToVertices;
		$vertSel = `ls -sl -fl -l`;

		select $sel[1];
		ConvertSelectionToVertices;
		$sourceSel = `ls -sl -fl -l`;
	}

	for ($i=0;$i<size($vertSel);$i++)
	{
		float $shortestDistance = 1000000;

		//select $vertSel[$i];
		float $vPos[] = `xform -q -ws -t $vertSel[$i]`;

		for ($j=0;$j<size($sourceSel);$j++)
		{
			float $testVert[] = `xform -q -ws -t $sourceSel[$j]`;
			float $testLength = ((($testVert[0] - $vPos[0])*($testVert[0] - $vPos[0])) + (($testVert[1] - $vPos[1])*($testVert[1] - $vPos[1])) + (($testVert[2] - $vPos[2])*($testVert[2] - $vPos[2])));

			if ($testLength < $shortestDistance)
			{
				$closestVert = $sourceSel[$j];
				$shortestDistance = $testLength;
			}

		}
		//print ($closestVert + "\n");
		float $wNormal[] = `polyNormalPerVertex -q -xyz $closestVert`;

		for ($k=0;$k<size($wNormal);$k=$k+3)
		{
			polyNormalPerVertex -xyz $wNormal[$k] $wNormal[$k+1] $wNormal[$k+2] $vertSel[$i];
		}
	}

	select -cl;

}

global proc TranferNormalTargetSource(){
	string $slObj[] = `ls -l -sl` ;
	DeleteHistory $slObj ;
	// make sure 2 selected Objs have mesh node
	if (size(`listRelatives -c -type mesh $slObj`) != 2){
		confirmDialog -t "GS: Transfer Normal" -m "Please select TARGET then SOURCE to transfer" -db "Yes" ;
		return ;
	}
	//print("Debug: Transfer Normal " + $slObj[1] + " - " + $slObj[0] + "\n") ;
	GS_TransferAttrNormal($slObj[1], $slObj[0]) ;
}
global proc MkRecessTargetSource(){
	string $slObj[] = `ls -l -sl` ;
	DeleteHistory $slObj ;
	// make sure 2 selected Objs have mesh node
	if (size(`listRelatives -c -type mesh $slObj`) != 2){
		confirmDialog -t "GS: Recess Coppy Normal" -m "Please select TARGET then \"RECESS badge\" to transfer" -db "Yes" ;
		return ;
	}
	GS_TransferNormal2RecessPart($slObj[1], $slObj[0]) ;
}
global proc TranferNormal2SelectedVertices(){
	GS_CopyNormals();
}

global proc callSelectSourceMesh(){
	string $slObjs[] = `ls -l -sl` ;
	if (size($slObjs) == 1){
		textField -e -text $slObjs[0] txtSrcMesh;
	}else{
		confirmDialog -t "GS Normal Tools" -m ("Please select only ONE mesh") -button "OK" ;
	}
}

global proc callTranferNormalFromSourceToSelectedMeshes()
{
	string $srcMesh = `textField -q -text txtSrcMesh`;
	
	string $slMesh[] = `ls -l -sl` ;
	for ($aMesh in $slMesh)
	{
	    string $shapeNode[] = `listRelatives -c -type mesh $aMesh`;
		if (!size($shapeNode)){
			continue ;
		}
		GS_TransferAttrNormal($srcMesh, $aMesh) ;
	}
}


proc DoMatchVertexNormal(string $objDst, string $objSrc){
	select -cl;
	string $srcVtf[] = `polyListComponentConversion -tvf $objSrc` ;
	$srcVtf = `ls -l -fl $srcVtf`;
	for ($aVtf in $srcVtf){
		float $vNormal[] = `polyNormalPerVertex -q -xyz $aVtf`;
		string $dstStr = `substitute $objSrc $aVtf $objDst`;
		polyNormalPerVertex -xyz $vNormal[0] $vNormal[1] $vNormal[2] $dstStr;
	}
	print("-------- DONE ----------\n");
}

global proc MatchVertexNormalOn2DupMeshes(){
	string $slMesh[] = `ls -l -sl`;
	if (size($slMesh)!= 2){
		print("Please select two Object: Target then Source\n");
		return;
	}
	DoMatchVertexNormal($slMesh[0], $slMesh[1]);
}

global proc GS_NormalTools_UI(){
	if (`window -ex NormaltoolsWin`)
        deleteUI NormaltoolsWin ;

	string $UI = (`getenv "GSTOOLS"`) + "scripts/tools/normal_tools/GS_NormalTools.ui" ;
    $UI = substituteAllString($UI, "/", "\\");

    string $gsNormalToolsVWin = `loadUI -uiFile  $UI` ;

	windowPref -enableAll false;
	showWindow $gsNormalToolsVWin ;
    window -e -topLeftCorner 500 200 -wh 262 350 $gsNormalToolsVWin ;
	windowPref -enableAll true;
}
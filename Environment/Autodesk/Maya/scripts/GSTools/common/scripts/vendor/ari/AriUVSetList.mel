//--------------------------------------------------------------------------
//
// ScriptName : AriUVSetList
// Contents   : UVSetをリスト化し、特定のUVSetを含むものだけ選択。
// Author     : Ari
// URL        : http://cgjishu.net/
// Since      : 2018/03
// Update     : 
//
//--------------------------------------------------------------------------


proc string[] getSelectObjList(){
	
	string $selects[] = `ls -sl`;
	
	string $objects[] = `polyListComponentConversion $selects`;
	
	string $objectList[];
	int $i=0;
	for($obj in $objects){
		if(`objectType $obj` == "mesh"){
			string $objTr[] = `listRelatives -p -pa -type "transform" $obj`;
			$objectList[$i] = $objTr[0];
			$i++;
		}
		if(`objectType $obj` == "transform"){
			$objectList[$i] = $obj;
			$i++;
		}
	}
	return $objectList;
}
proc textScrollWrite(string $textList[],string $textScroll){
	if(size($textList)==0)return;
	string $evalString = "textScrollList -e";
	for($text in $textList){
		$evalString = $evalString +" -a \""+$text+ "\"";
	}
	$evalString = $evalString + $textScroll;
	eval $evalString;
}
global proc AriUVList_selectUVSet(){
	global string $AriUVSetList_UVSetListTSL;
	global string $AriUVEditor_thisObject;
	string $selects[] = `ls -sl`;
	string $get[]=`textScrollList -q -si $AriUVSetList_UVSetListTSL`;
	if($get[0] != "---------------------------------------------"){
		string $sepa[];
		tokenize $get[0] " |" $sepa;
		string $uvSet;
		string $object;
		if(size($sepa)>=2){
			$uvSet = $sepa[size($sepa)-1];
			$object = $sepa[0];
			for($i=1;$i<size($sepa)-1;$i++){
				$object = $object + "|" + $sepa[$i];
			}
		}
		else{	
			$uvSet = $get[0];
			$object = $AriUVEditor_thisObject;
		}
		polyUVSet -currentUVSet -uvSet $uvSet $object;
		if(size($sepa)>=2){
			string $allList[] = `textScrollList -q -allItems $AriUVSetList_UVSetListTSL`;
			for($list in $allList){
				string $sepa[];
				tokenize $list " |" $sepa;
				string $otherUVSet =  $sepa[size($sepa)-1];
				string $otherObject = $sepa[0];
				for($i=1;$i<size($sepa)-1;$i++){
					$otherObject = $otherObject + "|" + $sepa[$i];
				}
				if($otherUVSet==$uvSet){
					polyUVSet -currentUVSet -uvSet $otherUVSet $otherObject;
				}
			}
		}
		select $selects;
	}
	AriUVList_getSetList();
}
global proc AriUVList_getSetList(){
	global string $AriUVSetList_UVSetListTSL;
	global string $AriUVEditor_thisObject;
	string $selects[] = `ls -sl`;
	string $objects[] = `polyListComponentConversion $selects`;	
	string $objectList[];
	int $i=0;
	for($obj in $objects){
		if(`objectType $obj` == "mesh"){
			string $objTr[] = `listRelatives -p -pa -type "transform" $obj`;
			$objectList[$i] = $objTr[0];
			$i++;
		}
		if(`objectType $obj` == "transform"){
			$objectList[$i] = $obj;
			$i++;
		}
	}
	textScrollList -e -ra $AriUVSetList_UVSetListTSL;
	$AriUVEditor_thisObject = $objectList[0];
	int $uvSetSize[];
	$uvSetSize[0]=0;
	$i=1;
	for($obj in $objectList){
		string $uvSet[] = `polyUVSet -q -allUVSets $obj`;
		$uvSetSize[$i]=size($uvSet);
		if(size($uvSet)){
			string $currentUVs[] = `polyUVSet -q -currentUVSet $obj`;
			string $CurrentUV = $currentUVs[0];
			string $evalString = "textScrollList -e";
			for($uv in $uvSet){
				if(size($objectList)>=2)$uv=$obj+" | "+$uv;
				$evalString = $evalString +" -a \""+$uv+ "\"";
			}
			$evalString = $evalString +" -a \"---------------------------------------------\"";
			$evalString = $evalString + $AriUVSetList_UVSetListTSL;
			eval $evalString;
			if(size($objectList)>=2)$CurrentUV=$obj+" | "+$CurrentUV;
			textScrollList -e -selectItem $CurrentUV $AriUVSetList_UVSetListTSL;
		}
		$i++;
	}
}
global proc AriUVList_GetObjfromUV(){
	global string $AriUVSetList_SelectList[];
	global string $AriUVSetList_textScroll[3];
	global string $AriUVSetList_OrAndRB[2];
	global string $AriUVSetList_UVSetListTSL;
	textScrollList -e -ra $AriUVSetList_textScroll[1];
	textScrollList -e -ra $AriUVSetList_textScroll[2];
	textScrollList -e -ra $AriUVSetList_UVSetListTSL;
	string $selectList[] = `textScrollList -q -selectItem $AriUVSetList_textScroll[0]`;
	string $findUVList[];
	int $orTrue  = false;
	int $notTrue = false;
	$orTrue = `radioButton -q -sl $AriUVSetList_OrAndRB[1]`;
	$findUVList = $selectList;
	string $trueObjList[];
	string $falseObjList[];
	clear $trueObjList;
	clear $falseObjList;
	int $i=0;
	int $j=0;
	for($obj in $AriUVSetList_SelectList){
		string $uvSet[] = `polyUVSet -q -allUVSets $obj`;
		if($orTrue == 1){
			for($uv in $uvSet){
				if(stringArrayContains($uv,$findUVList)){
					if(!stringArrayContains($obj,$trueObjList)){
						$trueObjList[$i] = $obj;
						$i++;
					}
				}
			}
		}
		else{
			int $uvTrue = true;
			for($uv in $findUVList){
				if(!stringArrayContains($uv,$uvSet)){
					$uvTrue = false;
				}
			}
			if($uvTrue){
				if(!stringArrayContains($obj,$trueObjList)){
					$trueObjList[$i] = $obj;
					$i++;
				}
			}
		}
	}
	string $viewObjList[];
	if($notTrue==false){
		$viewObjList = $trueObjList;
	}
	$i=0;
	for($obj in $AriUVSetList_SelectList){
		if(!stringArrayContains($obj,$trueObjList)){
			$falseObjList[$i] = $obj;
			$i++;
		}
	}
	textScrollWrite($trueObjList, $AriUVSetList_textScroll[1]);
	textScrollWrite($falseObjList,$AriUVSetList_textScroll[2]);
	int $total = `textScrollList -q -ni $AriUVSetList_textScroll[1]`;
	for($i=1; $i<=$total; $i++){
		textScrollList -e -sii $i $AriUVSetList_textScroll[1];
	}
	AriUVList_SelectsObj(1);
}
global proc AriUVList_SelectsObj(int $mode){
	global string $AriUVSetList_textScroll[3];
	int $unSelect=1;
	if($mode==1)$unSelect=2;
	textScrollList -e -da $AriUVSetList_textScroll[$unSelect];
	string $selectList[] = `textScrollList -q -selectItem $AriUVSetList_textScroll[$mode]`;
	select $selectList;
	AriUVList_getSetList();
}
global proc AriUVList_Get(){
	global string $AriUVSetList_SelectList[];
	global string $AriUVSetList_textScroll[3];
	string $objectList[] = getSelectObjList();
	textScrollList -e -ra $AriUVSetList_textScroll[0];
	textScrollList -e -ra $AriUVSetList_textScroll[1];
	textScrollList -e -ra $AriUVSetList_textScroll[2];
	$AriUVEditor_thisObject = $objectList[0];
	int $uvSetSize[];
	$uvSetSize[0]=0;
	int $i=1;
	$AriUVSetList_SelectList = $objectList;
	if(size($objectList)==0)return;
	string $uvList[];
	int $j=0;
	for($obj in $objectList){
		string $uvSet[] = `polyUVSet -q -allUVSets $obj`;
		$uvSetSize[$i] = size($uvSet);
		if(size($uvSet)){
			string $currentUVs[] = `polyUVSet -q -currentUVSet $obj`;
			string $CurrentUV = $currentUVs[0];
			for($uv in $uvSet){
				if(!stringArrayContains($uv,$uvList)){
					$uvList[$j] = $uv;
					$j++;
				}
			}
		}
	}
	textScrollWrite($uvList,$AriUVSetList_textScroll[0]);
	textScrollList -e -sii 1 $AriUVSetList_textScroll[0];
	AriUVList_GetObjfromUV();
}
proc AllUVSetListTSL(){
	global string $AriUVSetList_textScroll[4];
	global string $AriUVSetList_OrAndRB[2];
	string $form=`formLayout`;
	radioCollection;
		string $rowL = `rowLayout -nc 2`;
		$AriUVSetList_OrAndRB[0] = `radioButton -sl -label "AND" -onc "AriUVList_GetObjfromUV()"` ;
		$AriUVSetList_OrAndRB[1] = `radioButton     -label "OR"  -onc "AriUVList_GetObjfromUV()"` ;
		setParent..;
		$AriUVSetList_textScroll[0] = `textScrollList -ams true -sc "AriUVList_GetObjfromUV()"`;
		$getButton = `button -bgc 0.5 1 0.5 -l "Get" -c "AriUVList_Get();"`;
		$editorButton = `button -w 48 -l "Editor" -c "UVSetEditor"`;
	setParent..;
	formLayout -e
	-af $rowL "left" 0
	-af $rowL "bottom" 0
	-af $editorButton "right" 0
	-af $editorButton "bottom" 0
	-af $getButton "left"   0
	-af $getButton "right"  0
	-ac $getButton "bottom" 0 $editorButton
	-af $AriUVSetList_textScroll[0] "top"   0
	-af $AriUVSetList_textScroll[0] "left"   0
	-af $AriUVSetList_textScroll[0] "right"  0
	-ac $AriUVSetList_textScroll[0] "bottom"  0 $getButton
	$form;
}
proc objectListTSL_true(){
	global string $AriUVSetList_textScroll[4];
	$form = `formLayout`;
	$label = `text -l "TRUE"`;	
	$AriUVSetList_textScroll[1] = `textScrollList -ams true -h 20 -sc "AriUVList_SelectsObj(1)"`;
	setParent..;
	formLayout -edit
		-af $label "top" 0
		-af $label "left" 0
		-af $label "right" 0
		-ac $AriUVSetList_textScroll[1] "top" 0 $label
		-af $AriUVSetList_textScroll[1] "left"   0
		-af $AriUVSetList_textScroll[1] "bottom" 0
		-af $AriUVSetList_textScroll[1] "right"  0
	$form;
}
proc objectListTSL_false(){
	global string $AriUVSetList_textScroll[4];
	$form = `formLayout`;
	$label = `text -l "NOT"`;
	$AriUVSetList_textScroll[2] = `textScrollList -ams true -sc "AriUVList_SelectsObj(2)"`;
	setParent..;
	formLayout -edit
		-af $label "top" 0
		-af $label "left" 0
		-af $label "right" 0
		-ac $AriUVSetList_textScroll[2] "top" 0 $label
		-af $AriUVSetList_textScroll[2] "left"   0
		-af $AriUVSetList_textScroll[2] "bottom" 0
		-af $AriUVSetList_textScroll[2] "right"  0
	$form;
}
proc selectObjSetListTSL(){
	global string $AriUVSetList_UVSetListTSL;
	$AriUVSetList_UVSetListTSL =`textScrollList -ams true -sc "AriUVList_selectUVSet()"`;
}
global proc AriUVSetList(){
	global string $AriUVSetList_textScroll[4];
	if((`window -ex  AriUVSetList`)==true)deleteUI AriUVSetList;
	window -title "AriUVSetList" -mxb false -mnb false -w 200 -h 100 AriUVSetList;
	$form = `formLayout`;
	string $paneH = `paneLayout   -configuration "horizontal3"`;
	AllUVSetListTSL();
	string $paneV = `paneLayout -configuration "vertical2"`;
	objectListTSL_true();
	objectListTSL_false();
	setParent..;
	selectObjSetListTSL();
	setParent..;
	setParent..;
	formLayout -edit
		-af $paneH "top" 0
		-af $paneH "left"   0
		-af $paneH "bottom" 0
		-af $paneH "right"  0
	$form;
	showWindow;
	AriUVList_Get();
	AriUVList_GetObjfromUV();
}

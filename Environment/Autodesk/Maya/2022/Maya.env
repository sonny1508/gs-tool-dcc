GSTOOLS = %USERPROFILE%\Documents\maya\scripts\GSTools\common\
GSPIPELINE = %USERPROFILE%\Documents\maya\scripts\GSPipeline\
MAYA_SHELF_PATH = %USERPROFILE%\Documents\maya\scripts\GSTools\common\shelf
XBMLANGPATH = %USERPROFILE%\Documents\maya\scripts\GSTools\icons
MAYA_PLUG_IN_PATH = %USERPROFILE%\Documents\maya\plug-ins

// Telemetry. Both lines stay commented out in the repo so a checkout is inert
// by default; the studio deploy uncomments them and fills in the real values.
// With GS_TELEMETRY_URL unset, gstools.telemetry creates no thread and opens
// no socket, so the suite costs nothing when used off the studio LAN.
// GS_TELEMETRY_URL = http://<ubuntu-host>/api/method/gs_telemetry.api.ingest
// GS_TELEMETRY_TOKEN = <shared token, see site_config.json>

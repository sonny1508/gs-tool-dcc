        -style "iconOnly" 
        -marginWidth 0
        -marginHeight 1
        -command "import imp as imp\nimport maya.cmds as cmds\nimport sys\ntry:\n\treload\nexcept NameError:\n\tfrom importlib import reload\ncmds.loadPlugin(\"C:/Users/sonny.nguyen.01/Documents/maya/2025/scripts/giants_i3d_exporter_10.0.0//I3DExporter2025-x64.mll\", quiet=True)\nsys.path.append('C:/Users/sonny.nguyen.01/Documents/maya/2025/scripts/giants_i3d_exporter_10.0.0//')\nimport I3DExporter\nreload(I3DExporter)\nI3DExporter.I3DExport()" 
        -sourceType "python" 
        -commandRepeatable 1
        -flat 1
    ;
    shelfButton
        -enableCommandRepeat 1
        -flexibleWidthType 3
        -flexibleWidthValue 32
        -enable 1
        -width 35
        -height 34
        -manage 1
        -visible 1
        -preventOverride 0
        -annotation "Environment Tools" 
